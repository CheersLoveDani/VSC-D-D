{
  "name": "dnd-campaign-manager",
  "displayName": "D&D Campaign Manager",
  "description": "A VS Code extension for planning D&D campaigns with Maps, Character Sheets, and Item Databases.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dndnotes",
    "onLanguage:markdown",
    "onView:dnd-plugin-manager"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dndnotes",
        "aliases": [
          "D&D Notes",
          "dndnotes"
        ],
        "extensions": [
          ".dndnotes"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dndnotes",
        "scopeName": "text.html.markdown",
        "path": "./syntaxes/markdown.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "dnd.mapEditor",
        "displayName": "D&D Map Editor",
        "selector": [
          {
            "filenamePattern": "*.dndmap"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dnd.characterEditor",
        "displayName": "D&D Character Sheet",
        "selector": [
          {
            "filenamePattern": "*.dndchar"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dnd.itemEditor",
        "displayName": "D&D Item Database",
        "selector": [
          {
            "filenamePattern": "*.dnditem"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dnd.notesEditor",
        "displayName": "D&D Notes Editor",
        "selector": [
          {
            "filenamePattern": "*.dndnotes"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dnd-campaign-manager.createMap",
        "title": "D&D: Create New Map"
      },
      {
        "command": "dnd-campaign-manager.createCharacter",
        "title": "D&D: Create New Character"
      },
      {
        "command": "dnd-campaign-manager.togglePlainText",
        "title": "Toggle Plain Text Mode",
        "category": "D&D Manager"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dnd-manager",
          "title": "D&D Manager",
          "icon": "media/d20-icon.svg"
        }
      ]
    },
    "views": {
      "dnd-manager": [
        {
          "id": "dnd-plugin-manager",
          "name": "Plugin Manager"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  }
}