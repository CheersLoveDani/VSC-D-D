{
  "name": "critcode-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "CritCode - D&D Campaign Management Tools (Monorepo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/CheersLoveDani/VSC-D-D"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist out node_modules",
    "extension:compile": "pnpm --filter critcode compile",
    "extension:watch": "pnpm --filter critcode watch",
    "extension:package": "pnpm --filter critcode package"
  },
  "devDependencies": {
    "typescript": "^5.1.3"
  }
}
